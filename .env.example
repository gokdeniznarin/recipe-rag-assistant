# Bu dosyayı `.env` olarak kopyalayıp doldurun. `.env` gitignore'da ve
# .dockerignore sayesinde image'a da girmez.
#
#   cp .env.example .env

# ── Zorunlu ───────────────────────────────────────────────
# Google AI Studio'dan alınır: https://aistudio.google.com/apikey
# Metin üretimi, sorgu sınıflandırma ve fotoğraf analizi için.
GEMINI_API_KEY=

# ── Yerelde GEREKMEZ ──────────────────────────────────────
# Firebase service-account JSON'ının TAM İÇERİĞİ, tek satır metin olarak.
# Yalnızca PRODUCTION'da (Render env var) kullanılır; yerelde bunun yerine
# docker-compose `api/firebase-key.json` dosyasını salt-okunur mount ediyor.
# FIREBASE_CREDENTIALS_JSON=

# ── Opsiyonel ─────────────────────────────────────────────
# FatSecret Platform API — besin değeri araması.
# TANIMLI OLMASALAR DA UYGULAMA ÇALIŞIR: besin değerleri o zaman Gemini'nin
# tahmininden gelir ve arayüz bunu "AI estimate" olarak dürüstçe söyler.
# Anahtar eklendiğinde kod değişmeden aranmış veriye geçilir.
#
# ⚠️ FatSecret panelinde OAuth **1.0** bölümündeki değerler kullanılıyor
# (Consumer Key / Consumer Secret), OAuth 2.0 değil — 2.0 en az bir IP'nin
# whitelist'e alınmasını şart koşuyor ve Render'ın ücretsiz katmanında sabit
# giden IP yok.
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
